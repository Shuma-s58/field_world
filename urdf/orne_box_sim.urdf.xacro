<?xml version="1.0"?>
<!--
  orne-box のモデル(VLP-16 付き)に、MID360 のシミュレーション用センサを追加する。
  MID360 のリンク(livox_frame)は orne_box_description 側で既に
  base_link から xyz=(0.424, 0, 0.203), 下向き(rpy 0 π π/2)に取り付けてあるので、
  ここではそのリンクに Gazebo の ray センサを載せるだけ。
  MID360 仕様: 水平 360°, 垂直 -7°〜+52°(センサ座標), 10Hz, 最大 40m
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="orne_box">
  <xacro:include filename="$(find orne_box_description)/urdf/orne_box_3d_lidar_rfans.urdf.xacro"/>

  <!-- Webカメラ: 取り付け位置は base_link 基準 [m]。既定は前面の棚板(MID360 の吊り元)の上。
       後方マスト上にしたい場合: camera_x:=-0.12 camera_z:=0.90 -->
  <xacro:arg name="camera_x" default="0.40"/>
  <xacro:arg name="camera_y" default="0.0"/>
  <xacro:arg name="camera_z" default="0.29"/>
  <xacro:arg name="camera_pitch" default="0.0"/>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="$(arg camera_x) $(arg camera_y) $(arg camera_z)" rpy="0 $(arg camera_pitch) 0"/>
  </joint>
  <!-- 光学フレーム (z前方, x右, y下) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- 一般的なWebカメラ相当: 1280x720, 30fps, 水平画角 約70° -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="webcam">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="webcam_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="livox_frame">
    <sensor type="ray" name="mid360">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.122173</min_angle>
            <max_angle>0.907571</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="mid360_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=livox/lidar</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>livox_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
